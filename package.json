{
	"name": "@signageos/digital-signature",
	"version": "3.1.3",
	"description": "NodeJS SDK to generate and validate digital signatures",
	"main": "./lib/cjs/index.js",
	"module": "./lib/esm/index.js",
	"type": "commonjs",
	"packageManager": "pnpm@12.8.1",
	"files": [
		"lib/",
		"README.md",
		"package.json"
	],
	"scripts": {
		"start": "tsx examples/example.ts",
		"build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.esm.json && printf '{\"type\":\"module\"}\\n' > lib/esm/package.json",
		"clean-build": "rm -rf lib/* && pnpm run build",
		"lint": "eslint",
		"lint:prettier": "prettier \"**/*.+(ts|json|mjs)\" --check",
		"lint:prettier:fix": "prettier \"**/*.+(ts|json|mjs)\" --write",
		"test": "NODE_ENV=test mocha",
		"test:coverage": "c8 pnpm run test",
		"watch": "tsc -p tsconfig.build.json --watch",
		"check": "pnpm run depcheck && pnpx @signageos/lib-ci check-deps",
		"depcheck": "pnpx depcheck --config .depcheckrc.json",
		"check-types": "tsc --noEmit"
	},
	"keywords": [
		"signageOS",
		"Digital Signature",
		"ED25519",
		"RSA"
	],
	"author": "Lokesh Rishi",
	"license": "Apache-2.0",
	"dependencies": {
		"@types/express": "^4.17.13",
		"jose": "^4"
	},
	"devDependencies": {
		"@signageos/codestyle": "3.1.0",
		"@types/mocha": "10.0.10",
		"@types/node": "24.10.1",
		"@types/sinon": "17.0.4",
		"c8": "10.1.3",
		"express": "4.21.2",
		"mocha": "11.7.5",
		"should": "13.2.3",
		"sinon": "21.0.0",
		"tsx": "4.23.16-sos-fix-coverage.0",
		"typescript": "6.0.3"
	},
	"directories": {
		"example": "examples",
		"lib": "lib",
		"test": "test"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/signageos/lib-digital-signature"
	},
	"bugs": {
		"url": "https://github.com/signageos/lib-digital-signature/issues"
	},
	"homepage": "https://github.com/signageos/lib-digital-signature#readme",
	"engines": {
		"node": ">=20"
	}
}
